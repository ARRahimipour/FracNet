# FracNet research reproduction: copy this template to .env
# No credentials or private paths should be committed.
# Relative paths resolve from this file's parent directory.
FRACNET_SEED=42
FRACNET_MANIFEST=data/manifest.csv
FRACNET_UNLABELED_DIR=data/ssl_unlabeled
FRACNET_OUTPUT_DIR=runs/full
FRACNET_SCENARIO=full
FRACNET_DATASETS=D1,D2,D3

FRACNET_XCEPTION_MODEL=legacy_xception
FRACNET_MOBILENET_MODEL=mobilenetv2_100
FRACNET_EFFICIENTNET_MODEL=efficientnet_b0
FRACNET_XCEPTION_IMAGE_SIZE=299
FRACNET_MOBILENET_IMAGE_SIZE=224
FRACNET_EFFICIENTNET_IMAGE_SIZE=224

FRACNET_PRETRAINED_IMAGENET=true
FRACNET_FREEZE_FRACTION=0.70
FRACNET_BATCH_SIZE=15
FRACNET_NUM_WORKERS=4
FRACNET_EPOCHS=100
FRACNET_SSL_EPOCHS=50
FRACNET_SSL_TEMPERATURE=0.2
FRACNET_LEARNING_RATE=0.001
FRACNET_WEIGHT_DECAY=0.0001
FRACNET_EARLY_STOPPING_PATIENCE=12
FRACNET_VAL_FRACTION=0.15
FRACNET_TEST_FRACTION=0.15
FRACNET_CORRELATION_THRESHOLD=0.95
FRACNET_Z_SCORE_THRESHOLD=3.0
FRACNET_OUTLIER_ROW_FEATURE_FRACTION=0.02
FRACNET_RF_N_ESTIMATORS=100
FRACNET_PCA_VARIANCE=0.95
FRACNET_TSNE_MAX_SAMPLES=1500
FRACNET_VOTE_MODELS=xgboost,svm,knn
FRACNET_SSL_MAX_IMAGES=

